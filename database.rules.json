{
  "rules": {
    ".read": "auth != null",
    "nel_landscape_v1": {
      ".write": "auth != null && newData.exists() && (!data.child('properties').exists() || newData.child('properties').exists())"
    },
    "nel_landscape_backups": {
      "$key": {
        ".write": "auth != null && !data.exists() && newData.exists()"
      }
    }
  }
}
